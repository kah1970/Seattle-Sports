{
  "name": "seattle-sports-intel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:prune": "npx tsx scripts/prune-off-topic.ts",
